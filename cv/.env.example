# Copy to cv/.env.local (ignored by Git). Never commit real values.
# Same project URL and publishable key as the app's .env.local (EXPO_PUBLIC_SUPABASE_*).
GC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
GC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY
# A coordinator/safety-lead account on the demo event, used only by the camera.
# Never use the service-role key here.
GC_EMAIL=camera@example.com
GC_PASSWORD=
# The demo event: its id, or its exact name.
GC_EVENT_ID=
GC_EVENT_NAME=Riverside 2026
